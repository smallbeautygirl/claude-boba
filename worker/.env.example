HUB_URL=http://127.0.0.1:8787

# 在網頁「我的 worker」按「產生 token」拿到。worker 完全不需要你的 Observ 帳密 ——
# 把公司密碼寫進 .env 是不必要的風險。
WORKER_TOKEN=

# 出租者的 Claude Code 憑證。唯讀掛入 job 容器，不進 image、不進環境變數。
CLAUDE_CREDENTIALS=/home/you/.claude/.credentials.json

# 每個 job 的花費硬上限。逾時只擋「跑太久」，擋不住「跑很貴」——
# 一個 Opus job 八分鐘能燒掉 US$25，那會讓債務從一杯飲料跳到一頓好料。
JOB_BUDGET_USD=5
TIMEOUT_SECONDS=600
MAX_CONCURRENCY=1

# 站台會再跟自己的白名單取交集。預設不含 Fable：它的 output 單價是 Haiku 的 10 倍。
AVAILABLE_MODELS=sonnet,haiku

# false = job 容器只連得到 api.anthropic.com。開放會讓 pip install / WebFetch 能用，
# 但也讓借用者的內容能連出去。見 .claude/rules/security.md 紅線 3。
ALLOW_FULL_NETWORK=false
