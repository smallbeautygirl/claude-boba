DATABASE_URL=postgresql+asyncpg://boba:boba@localhost:55432/boba
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=boba
S3_SECRET_KEY=change-me
S3_BUCKET=claude-boba
# 預簽 URL 用的對外位址。瀏覽器不在 Hub 的 localhost 上，所以這裡要填這台機器
# 在區網上的位址（例如 http://192.168.x.x:9000），不是 localhost。
S3_PUBLIC_ENDPOINT=
# 認證來源（Observ）。**兩個都沒設，Hub 會拒絕啟動** —— 少了它們沒有人登得進來，
# 而失敗會長得像「帳號密碼錯了」。內部部署的人跟站台管理者要這兩個值。
OBSERV_BASE_URL=
OBSERV_SERVICE_ID=
# 站台管理者的 email，逗號分隔。大小寫與前後空白會被正規化。
# 沒設 = 沒有人是管理者（刻意的 fail closed，不要改成「沒設就都是」）。
# 管理頁看得到系統健康、不指名的聚合數字、卡住的 job，看不到誰欠誰。
ADMIN_EMAILS=
# MinIO console 的網址（不是 S3_PUBLIC_ENDPOINT，埠號不同）。
# 只顯示在「我來代跑」頁 —— 那個 console 是整個 bucket 全開，看得到所有人的
# 檔案，所以不給借用者。沒設就不顯示這一段。
S3_CONSOLE_URL=
# 通知裡連回 job 頁面用
WEB_BASE_URL=http://localhost:5173
# 共用頻道的 Workflows webhook。沒設個人 webhook 的人走這裡（@mention 會通知到本人）
TEAMS_CHANNEL_WEBHOOK=
# 那個頻道叫什麼。整串原字串會直接顯示在通知設定頁上，所以寫成人看得懂、
# 找得到的樣子（團隊名 + 頻道名），例如：Playground 團隊的 claude-boba 頻道
TEAMS_CHANNEL_NAME=
# 掛債通知要不要進頻道
TEAMS_CHANNEL_DEBTS=true
TOKEN_ENCRYPTION_KEY=
# 代跑者長期 token 的加密金鑰。沒設 Hub 不會啟動（security.md 紅線 2）。

# 領單主機的身分。worker/.env 的 WORKER_TOKEN 要填一模一樣的一串。
#
# **沒設就一律拒絕領單**，不給預設值 —— 給了等於讓一個空設定檔變成任何人都能
# 領走別人的 job，連同各代跑者的一年期 OAuth token。
# 一台主機服務所有出借帳號（SPEC §4.12），所以這串等於全站的領單權限。
WORKER_SHARED_TOKEN=

# 管理頁「累計花費」的台幣粗估，匯率來源（台銀牌價的鏡像）。
# 留空 = 不換算，那一頁只顯示美金並說明原因。不要改成寫死的係數。
FX_API_URL=https://api.finmindtrade.com/api/v4/data
